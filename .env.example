# Copy this file to .env.local (git-ignored) and fill in your values.
# Find your PC's Wi-Fi IP in PowerShell:
#   (Get-NetIPAddress -InterfaceAlias Wi-Fi -AddressFamily IPv4).IPAddress

# Backend the app talks to (required).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Address Expo puts in the QR code. Without it Expo may pick the WSL adapter,
# which the phone can't reach.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10
